---
// Hacker mode: a fixed HUD, a boot sequence, and the "type root anywhere" egg.
// All behavior no-ops unless html[data-theme="hacker"].
---
<div class="hud" aria-hidden="true">
  <span class="seg"><span class="hled"></span> anishde.dev</span>
  <span class="seg hnodes">up <b id="hudUp">00:00:00</b></span>
  <span class="seg haccess">access: <b id="hudAccess">guest</b></span>
</div>
<div class="crt-glass" aria-hidden="true"></div>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <filter id="crtbarrel" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
    <feImage id="crtmap" preserveAspectRatio="none" result="m" />
    <feDisplacementMap in="SourceGraphic" in2="m" xChannelSelector="R" yChannelSelector="G" scale="80" />
  </filter>
</svg>

<script>
  import { rainFrame } from '../lib/rain';

  const root = document.documentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STORE = 'pf-designer';

  function save(patch: Record<string, string>) {
    let s: Record<string, string> = {};
    try { s = JSON.parse(localStorage.getItem(STORE) || '{}'); } catch {}
    Object.assign(s, patch);
    localStorage.setItem(STORE, JSON.stringify(s));
  }

  const BOOT = [
    ['booting anishde.dev', 'ok'],
    ['mounting /dev/beanstalk', 'ok'],
    ['loading rust toolchain', 'ok'],
    ['spawning 112 agents', 'ok'],
    ['checking caffeine levels', 'CRITICAL'],
    ['sleep.service', 'failed to start (expected)'],
    ['uplink → bengaluru', 'ok'],
  ];

  // the machine boots once per tab — navigating around doesn't power-cycle it
  const BOOTED = 'pf-booted';

  function boot(after?: () => void) {
    if (reduce) { after?.(); return; }
    sessionStorage.setItem(BOOTED, '1');
    const scr = document.createElement('div');
    scr.className = 'boot';
    scr.innerHTML = '<div id="bootlines"></div><span class="skip">click / any key to skip</span>';
    document.body.appendChild(scr);
    const lines = scr.querySelector('#bootlines')!;
    let i = 0, killed = false;

    function done() {
      if (killed) return; killed = true;
      scr.remove();
      window.removeEventListener('keydown', skip, true);
      after?.();
    }
    function skip() { done(); }
    window.addEventListener('keydown', skip, true);
    scr.addEventListener('click', skip);

    function step() {
      if (killed) return;
      if (i >= BOOT.length) {
        const p = document.createElement('div');
        p.className = 'bl';
        p.innerHTML = '\n<span class="ok">access granted.</span> welcome, guest.\ntip: type <b>root</b> if you think you\'re clever.';
        lines.appendChild(p);
        setTimeout(done, 1100);
        return;
      }
      const [label, tag] = BOOT[i++];
      const el = document.createElement('div');
      el.className = 'bl';
      const cls = tag === 'ok' ? 'ok' : 'crit';
      el.innerHTML = `${label} ... <span class="${cls}">[${tag}]</span>`;
      lines.appendChild(el);
      setTimeout(step, 120 + Math.min(i, 5) * 20);
    }
    step();
  }

  /* crt power cycle: collapse to a line, flip the world, power back on */
  function crtSwitch(flip: () => void, powerOn = true) {
    if (reduce) { flip(); return; }
    root.classList.add('crt-off');
    setTimeout(() => {
      flip();
      root.classList.remove('crt-off');
      if (powerOn) {
        root.classList.add('crt-on');
        setTimeout(() => root.classList.remove('crt-on'), 480);
      }
    }, 390);
  }

  function enterHacker(withBoot = true) {
    if (root.dataset.theme === 'hacker') return;
    crtSwitch(() => {
      root.dataset.theme = 'hacker';
      save({ theme: 'hacker' });
      dispatchEvent(new CustomEvent('pf:theme', { detail: 'hacker' }));
      if (withBoot) boot();
    }, !withBoot);
  }
  function exitHacker() {
    stopRain();
    closeLog();
    sessionStorage.removeItem(BOOTED); // next entry gets the boot again
    crtSwitch(() => {
      delete root.dataset.theme;
      delete root.dataset.access;
      root.style.setProperty('--prompt', "'guest@anishde:~$'");
      document.getElementById('hudAccess')!.textContent = 'guest';
      save({ theme: 'void', access: 'guest' });
      dispatchEvent(new CustomEvent('pf:theme', { detail: 'void' }));
    });
  }
  function escalate() {
    root.dataset.access = 'root';
    root.style.setProperty('--prompt', "'root@anishde:~#'");
    document.getElementById('hudAccess')!.textContent = 'root';
    save({ access: 'root' });
    dispatchEvent(new CustomEvent('pf:root'));
  }

  // defer one frame so sibling scripts (Designer's URL/localStorage apply) finish first
  requestAnimationFrame(() => {
    if (root.dataset.access === 'root') {
      root.style.setProperty('--prompt', "'root@anishde:~#'");
      document.getElementById('hudAccess')!.textContent = 'root';
    }
    if (root.dataset.theme === 'hacker' && !reduce && !sessionStorage.getItem(BOOTED)) boot();
  });

  // egg: type "root" anywhere. guest → enters hacker mode. inside → escalates.
  let buf = '';
  addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA') return;
    if (e.key.length !== 1 || e.metaKey || e.ctrlKey || e.altKey) return;
    buf = (buf + e.key.toLowerCase()).slice(-8);
    if (buf.endsWith('root')) {
      buf = '';
      if (root.dataset.theme !== 'hacker') enterHacker();
      else if (root.dataset.access !== 'root') escalate();
    }
  });

  /* ---- barrel displacement map for the scanline warp ---- */
  function buildBarrel() {
    const N = 256; // coarse maps wobble glyphs once stretched to the viewport
    const c = document.createElement('canvas');
    c.width = N; c.height = N;
    const ctx = c.getContext('2d')!;
    const img = ctx.createImageData(N, N);
    for (let y = 0; y < N; y++) {
      for (let x = 0; x < N; x++) {
        const nx = (x / (N - 1)) * 2 - 1;
        const ny = (y / (N - 1)) * 2 - 1;
        const r2 = (nx * nx + ny * ny) / 2; // 0 center → 1 corners
        const i = (y * N + x) * 4;
        img.data[i]     = Math.round(128 + nx * r2 * 110); // R: x displacement
        img.data[i + 1] = Math.round(128 + ny * r2 * 110); // G: y displacement
        img.data[i + 2] = 128;
        img.data[i + 3] = 255;
      }
    }
    ctx.putImageData(img, 0, 0);
    const map = document.getElementById('crtmap')!;
    const filt = document.getElementById('crtbarrel')!;
    map.setAttribute('href', c.toDataURL());
    const w = innerWidth, h = innerHeight;
    for (const el of [map, filt]) {
      el.setAttribute('x', '0'); el.setAttribute('y', '0');
      el.setAttribute('width', String(w)); el.setAttribute('height', String(h));
    }
  }
  buildBarrel();
  let brt: ReturnType<typeof setTimeout>;
  addEventListener('resize', () => { clearTimeout(brt); brt = setTimeout(buildBarrel, 200); });

  /* ---- hud: session uptime — real, which is why it gets to stay ---- */
  const t0 = performance.now();
  const hudUp = document.getElementById('hudUp')!;
  setInterval(() => {
    const s = Math.floor((performance.now() - t0) / 1000);
    const pad = (n: number) => String(n).padStart(2, '0');
    hudUp.textContent = `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`;
  }, 1000);

  /* ---- session log: tail -f /var/log/visitor.log (never leaves the page) ---- */
  const slines: string[] = [];
  let slog: HTMLElement | null = null;
  let curSection = 'top';
  const stamp = () => new Date().toLocaleTimeString('en-GB', { hour12: false });
  function who() { return root.dataset.access === 'root' ? 'root' : 'guest'; }
  function sl(msg: string) {
    slines.push(`[${stamp()}] ${msg}`);
    if (slines.length > 9) slines.shift();
    if (slog) slog.querySelector('.sl-body')!.textContent = slines.join('\n');
  }
  function openLog() {
    if (slog) return;
    slog = document.createElement('div');
    slog.className = 'seslog';
    slog.innerHTML = '<div class="sl-head">tail -f /var/log/visitor.log</div><div class="sl-body"></div>';
    document.body.appendChild(slog);
    sl(`${who()} opened the log. bold.`);
  }
  function closeLog() { slog?.remove(); slog = null; }

  // observers (cheap; only render when panel open)
  document.querySelectorAll('.label').forEach((el) => {
    new IntersectionObserver((en) => en.forEach((e) => {
      if (e.isIntersecting) {
        const name = (el.textContent || '').replace(/\(\d+\)/, '').trim().replace(/\s+/g, '-');
        if (name && name !== curSection) { curSection = name; sl(`${who()} scrolled to /${name}`); }
      }
    }), { threshold: 0.6 }).observe(el);
  });
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a, button');
    if (!a) return;
    const label = (a.textContent || '').trim().slice(0, 28) || a.tagName.toLowerCase();
    sl(`${who()} clicked "${label}"`);
  });
  document.addEventListener('copy', () => sl(`${who()} copied something. we saw that.`));
  document.addEventListener('visibilitychange', () =>
    sl(document.hidden ? `${who()} looked away` : `${who()} came back`));
  let typedAt = 0;
  addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA') return;
    if (performance.now() - typedAt > 4000) sl(`${who()} is typing something…`);
    typedAt = performance.now();
  });

  /* ---- matrix rain (:rain) — phosphor-colored, sits behind the content ---- */
  let rainC: HTMLCanvasElement | null = null, rainRaf = 0;
  function stopRain() {
    if (!rainC) return;
    cancelAnimationFrame(rainRaf);
    rainC.remove(); rainC = null;
  }
  function toggleRain() {
    if (rainC) { stopRain(); return; }
    if (reduce) return;
    rainC = document.createElement('canvas');
    Object.assign(rainC.style, { position: 'fixed', inset: '0', zIndex: '0', opacity: '.26', pointerEvents: 'none' });
    document.body.appendChild(rainC);
    const ctx = rainC.getContext('2d')!;
    let W = 0, H = 0, drops: number[] = [];
    function fit() {
      W = rainC!.width = innerWidth; H = rainC!.height = innerHeight;
      drops = Array(Math.ceil(W / 16)).fill(0).map(() => (Math.random() * H) / 16);
    }
    fit();
    addEventListener('resize', fit);
    let last = 0;
    function fall(ts: number) {
      rainRaf = requestAnimationFrame(fall);
      if (ts - last < 50) return;
      last = ts;
      const live = getComputedStyle(root).getPropertyValue('--live').trim() || '#33ff88';
      rainFrame(ctx, W, H, drops, 16, 'monospace', 0.10, live);
    }
    rainRaf = requestAnimationFrame(fall);
  }

  /* ---- :crash — kernel panic, then reboot ---- */
  function crash() {
    if (reduce) return;
    const scr = document.createElement('div');
    scr.className = 'boot';
    const box = document.createElement('div');
    scr.appendChild(box);
    document.body.appendChild(scr);
    scr.addEventListener('click', () => { scr.remove(); boot(); }, { once: true });
    const PANIC = [
      ['[ 1337.420690] Kernel panic - not syncing: skill issue detected', 'panic'],
      ['[ 1337.420691] CPU: 0 PID: 1 Comm: anishde.dev Tainted: G        WTF', ''],
      ['[ 1337.420692] Call Trace:', ''],
      ['[ 1337.420693]  <TASK>', ''],
      ['[ 1337.420694]  sleep_schedule+0x0/0xffff [never_loaded]', ''],
      ['[ 1337.420695]  drink_coffee+0x420/0x69 [caffeine]', ''],
      ['[ 1337.420696]  ship_it+0x1/0x1 [beanstalk]', ''],
      ['[ 1337.420697]  </TASK>', ''],
      ['[ 1337.420698] ---[ end Kernel panic - not syncing: skill issue detected ]---', 'panic'],
    ];
    let i = 0;
    (function dump() {
      if (i >= PANIC.length) {
        setTimeout(() => { box.innerHTML = ''; }, 3200);
        setTimeout(() => { if (scr.isConnected) { scr.remove(); boot(); } }, 3900);
        return;
      }
      const [line, cls] = PANIC[i++];
      const el = document.createElement('div');
      el.className = 'bl' + (cls ? ' ' + cls : '');
      el.textContent = line;
      box.appendChild(el);
      setTimeout(dump, 40);
    })();
    sl('system crashed. someone touched something.');
  }

  /* ---- :hack — pure theater ---- */
  function hack() {
    if (reduce) return;
    const scr = document.createElement('div');
    scr.className = 'boot';
    const box = document.createElement('div');
    scr.appendChild(box);
    document.body.appendChild(scr);
    const put = (html: string) => {
      const el = document.createElement('div');
      el.className = 'bl';
      el.innerHTML = html;
      box.appendChild(el);
      return el;
    };
    put('target: anishde.dev mainframe');
    setTimeout(() => put('scanning ports .... 22 443 1337 <span class="ok">[open]</span>'), 350);
    let bar: HTMLElement;
    setTimeout(() => { bar = put('bypassing firewall [----------] 0%'); }, 750);
    setTimeout(() => {
      let p = 0;
      const iv = setInterval(() => {
        p += 7 + ((Math.random() * 9) | 0);
        if (p >= 100) { p = 100; clearInterval(iv); }
        const n = Math.round(p / 10);
        bar.textContent = `bypassing firewall [${'█'.repeat(n)}${'-'.repeat(10 - n)}] ${p}%`;
      }, 110);
    }, 800);
    setTimeout(() => put('spoofing mac address ... <span class="ok">ok</span>'), 2300);
    setTimeout(() => {
      for (let r = 0; r < 3; r++) {
        let hex = '';
        for (let i = 0; i < 8; i++) hex += ((Math.random() * 0xffff) | 0).toString(16).padStart(4, '0') + ' ';
        put('0x' + (0x7f00 + r * 16).toString(16) + ':  ' + hex);
      }
    }, 2600);
    setTimeout(() => put('<span class="grant">ACCESS GRANTED</span>'), 3300);
    setTimeout(() => put("just kidding. hire me instead → contact[at]anishde[dot]dev"), 4100);
    setTimeout(() => scr.remove(), 10_000);
    scr.addEventListener('click', () => scr.remove());
  }

  // bridge for terminal + designer
  (window as any).pfHacker = {
    enter: () => enterHacker(),
    exit: exitHacker,
    root: () => { if (root.dataset.theme !== 'hacker') enterHacker(); else escalate(); },
    isHacker: () => root.dataset.theme === 'hacker',
    isRoot: () => root.dataset.access === 'root',
    log: () => (slog ? closeLog() : openLog()),
    rain: toggleRain,
    crash,
    hack,
  };

  // undocumented test hooks: ?fx=rain|crash|hack|log
  const fx = new URLSearchParams(location.search).get('fx');
  if (fx) requestAnimationFrame(() => (window as any).pfHacker[fx]?.());

  // designer theme toggle drives boot / exit (designer already set data-theme)
  addEventListener('pf:designer', (e: any) => {
    if (e.detail?.key !== 'theme') return;
    if (e.detail.value === 'hacker') boot();
    else exitHacker();
  });
</script>
