---
const name = 'ANISH DE';
const letters = [...name];
---
<header class="hero">
  <div class="topline">
    <button class="status" id="status" title="click for another one">
      <span class="dot"></span><span id="statusText">building beanstalk</span>
    </button>
    <span class="place"><span class="loc">bengaluru · </span><span id="clock">--:--</span> ist<span id="wx"></span></span>
  </div>

  <h1 class="sr">Anish De</h1>
  <div class="mast" aria-hidden="true">
    <canvas class="m m-pixel" id="mpixel"></canvas>
    <div class="m m-doto" id="mdoto">
      {letters.map((ch) => (ch === ' ' ? <span class="sp"> </span> : <span class="ch">{ch}</span>))}
    </div>
    <div class="m m-serif">Anish De</div>
    <div class="m m-mono">anish de<span class="cursor"></span></div>
  </div>

  <div class="byline">co-founder, <b>beanstalk</b> · previously spicenet</div>
</header>

<style>
  .hero{ padding-top:clamp(56px, 12vh, 120px); }
  html[data-density="compact"] .hero{ padding-top:clamp(40px, 8vh, 72px); }
  html[data-density="compact"] .topline{ margin-bottom:clamp(24px, 4vh, 36px); }
  .topline{
    display:flex; justify-content:space-between; align-items:baseline; gap:16px;
    font-family:var(--mono); font-size:10px; letter-spacing:.22em; text-transform:lowercase;
    color:var(--ink-dim); margin-bottom:clamp(34px, 6vh, 56px);
  }
  .status{
    display:flex; align-items:center; gap:8px;
    font:inherit; letter-spacing:inherit; text-transform:inherit; color:inherit;
    background:none; border:none; cursor:pointer; padding:0;
  }
  .dot{
    width:6px; height:6px; border-radius:50%; background:var(--live); flex:none;
    animation:pulse 2.6s ease-out infinite;
  }
  @keyframes pulse{
    0%{ box-shadow:0 0 0 0 color-mix(in srgb, var(--live) 35%, transparent) }
    70%{ box-shadow:0 0 0 7px transparent }
    100%{ box-shadow:0 0 0 0 transparent }
  }
  #statusText{ transition:opacity .3s ease; }
  .place{ text-align:right; white-space:nowrap; }
  @media (max-width:480px){ .loc{ display:none; } }

  /* ---- the name: one of four treatments, picked in the designer ---- */
  .m{ display:none; }

  html:not([data-name]) .m-pixel, html[data-name="pixel"] .m-pixel{ display:block; }
  html[data-name="doto"] .m-doto{ display:block; }
  html[data-name="serif"] .m-serif{ display:block; }
  html[data-name="mono"] .m-mono{ display:block; }

  .m-pixel{ height:49px; cursor:default; }

  .m-doto{
    font-family:var(--dot);
    font-size:clamp(2.3rem, 8.5vw, 3.4rem);
    font-variation-settings:'ROND' 100, 'wght' 700;
    color:var(--ink); line-height:1; letter-spacing:.06em;
    cursor:default; user-select:none;
  }
  .m-doto .ch{ display:inline-block; font-variation-settings:inherit; }
  .m-doto .sp{ display:inline-block; width:.5em; }

  .m-serif{
    font-family:'Fraunces', var(--serif);
    font-size:clamp(2.6rem, 9vw, 3.8rem);
    font-weight:800; font-variation-settings:'opsz' 144;
    color:var(--ink); line-height:1; letter-spacing:-.015em;
  }

  .m-mono{
    font-family:var(--mono); font-weight:700;
    font-size:clamp(2rem, 7.5vw, 2.9rem);
    color:var(--ink); line-height:1; letter-spacing:-.02em;
  }
  .cursor{
    display:inline-block; width:.5em; height:.95em; margin-left:.18em;
    background:var(--live); vertical-align:-.08em;
    animation:blink 1.1s steps(1) infinite;
  }
  @keyframes blink{ 50%{ opacity:0 } }

  .byline{
    font-family:var(--mono); font-size:11px; letter-spacing:.2em; text-transform:lowercase;
    color:var(--ink-dim); margin-top:22px;
  }
  .byline b{ color:var(--ink-body); font-weight:400; }

  @media (prefers-reduced-motion:reduce){ .dot,.cursor{ animation:none; } }
</style>

<script>
  import { GLYPHS, pixelCols } from '../lib/pixel';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hover = matchMedia('(hover: hover)').matches;

  /* ist clock */
  const clock = document.getElementById('clock');
  (function tick() {
    clock!.textContent = new Date().toLocaleTimeString('en-GB', {
      timeZone: 'Asia/Kolkata', hour12: false, hour: '2-digit', minute: '2-digit',
    });
    setTimeout(tick, 15_000);
  })();

  /* bengaluru weather, quietly */
  const wx = document.getElementById('wx')!;
  const WX_WORDS: Record<number, string> = {
    0: 'clear', 1: 'clear', 2: 'clouds', 3: 'clouds', 45: 'haze', 48: 'haze',
    51: 'drizzle', 53: 'drizzle', 55: 'drizzle', 61: 'rain', 63: 'rain', 65: 'rain',
    80: 'rain', 81: 'rain', 82: 'rain', 95: 'storm', 96: 'storm', 99: 'storm',
  };
  async function weather() {
    try {
      const r = await fetch('https://api.open-meteo.com/v1/forecast?latitude=12.97&longitude=77.59&current=temperature_2m,weather_code');
      const j = await r.json();
      const word = WX_WORDS[j.current.weather_code];
      wx.textContent = ` · ${Math.round(j.current.temperature_2m)}°${word ? ' ' + word : ''}`;
    } catch { /* the sky stays a mystery */ }
  }
  weather();
  setInterval(weather, 30 * 60 * 1000);

  /* status — click the dot for the next one. it doesn't rotate on its own;
     nothing on this page should move unless asked. */
  const st = document.getElementById('statusText')!;
  const states = [
    'building beanstalk',
    'at the gym, allegedly',
    'negotiating with rustc',
  ];
  let si = 0;
  const hour = new Date().getHours();
  if (hour >= 0 && hour < 5) st.textContent = 'why are we both awake';
  function flash(msg: string) {
    st.style.opacity = '0';
    setTimeout(() => { st.textContent = msg; st.style.opacity = '1'; }, 300);
  }
  function next() {
    si = (si + 1) % states.length;
    flash(states[si]);
  }
  document.getElementById('status')!.addEventListener('click', next);

  /* egg: type "f1" anywhere (also :f1 in the terminal) */
  let lastKey = '', lastAt = 0;
  addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA') return;
    if (e.key === '1' && lastKey === 'f' && performance.now() - lastAt < 900) {
      flash("it's lights out and away we go");
    }
    lastKey = e.key; lastAt = performance.now();
  });
  addEventListener('pf:f1', () => flash("it's lights out and away we go"));

  /* ---- pixel name: same 5x7 dot language as the specimen ---- */
  const TEXT = 'ANISH DE';
  const pixel = document.getElementById('mpixel') as HTMLCanvasElement;
  const px = pixel.getContext('2d')!;
  const shades = ['#ece8e0', '#ece8e0', '#ece8e0', '#ece8e0', '#b8b3a8', '#b8b3a8', '#6b675e'];
  const dpr = Math.min(devicePixelRatio || 1, 2);
  let cells: { x: number; y: number; c: string }[] = [];
  let CELL = 7, cols = 0;
  let pmx = -9999, pmy = -9999;

  function buildPixel() {
    cols = pixelCols(TEXT);
    const maxW = pixel.parentElement!.clientWidth;
    CELL = Math.min(7, Math.floor(maxW / cols));
    const W = cols * CELL, H = 7 * CELL;
    pixel.width = W * dpr; pixel.height = H * dpr;
    pixel.style.width = W + 'px'; pixel.style.height = H + 'px';
    px.setTransform(dpr, 0, 0, dpr, 0, 0);

    // seeded per load, stable while you look at it
    cells = [];
    let cx = 0;
    for (const ch of TEXT) {
      if (ch === ' ') { cx += 3; continue; }
      const glyph = GLYPHS[ch];
      for (let r = 0; r < 7; r++)
        for (let c = 0; c < 5; c++)
          if (glyph[r][c] === '1')
            cells.push({ x: cx + c, y: r, c: shades[(Math.random() * shades.length) | 0] });
      cx += 6;
    }
    paintPixel();
  }
  function paintPixel() {
    px.clearRect(0, 0, pixel.width, pixel.height);
    const dotSize = CELL - 1;
    for (const cell of cells) {
      const X = cell.x * CELL, Y = cell.y * CELL;
      if (hover && !reduce) {
        const d = Math.hypot(X + CELL / 2 - pmx, Y + CELL / 2 - pmy);
        px.fillStyle = d < 60 ? '#fcfbf5' : cell.c;
      } else px.fillStyle = cell.c;
      px.fillRect(X, Y, dotSize, dotSize);
    }
  }
  buildPixel();
  let prt: ReturnType<typeof setTimeout>;
  addEventListener('resize', () => { clearTimeout(prt); prt = setTimeout(buildPixel, 150); });
  if (hover && !reduce) {
    pixel.addEventListener('mousemove', (e) => {
      const b = pixel.getBoundingClientRect();
      pmx = e.clientX - b.left; pmy = e.clientY - b.top;
      requestAnimationFrame(paintPixel);
    });
    pixel.addEventListener('mouseleave', () => { pmx = -9999; pmy = -9999; requestAnimationFrame(paintPixel); });
  }

  /* egg: after 90s idle, the name breathes — one dither flicker, like a screensaver */
  if (!reduce) {
    let idleT: ReturnType<typeof setTimeout>;
    function armIdle() { clearTimeout(idleT); idleT = setTimeout(glitch, 90_000); }
    function glitch() {
      if (document.hidden || document.documentElement.dataset.name !== 'pixel') { armIdle(); return; }
      const orig = cells.map((c) => c.c);
      const scramble = () => {
        for (const c of cells) if (Math.random() < 0.35) c.c = shades[(Math.random() * shades.length) | 0];
        paintPixel();
      };
      const restore = () => { cells.forEach((c, i) => (c.c = orig[i])); paintPixel(); };
      scramble();
      setTimeout(restore, 130);
      setTimeout(scramble, 250);
      setTimeout(() => { restore(); armIdle(); }, 390);
    }
    ['mousemove', 'keydown', 'scroll', 'touchstart'].forEach((ev) =>
      addEventListener(ev, armIdle, { passive: true }));
    armIdle();
  }

  /* ---- doto name: dots square up and thicken near the cursor ---- */
  const mdoto = document.getElementById('mdoto')!;
  const chars = [...mdoto.querySelectorAll<HTMLElement>('.ch')];
  if (!reduce && hover) {
    const cur = chars.map(() => ({ r: 100, w: 700 }));
    const tgt = chars.map(() => ({ r: 100, w: 700 }));
    let raf = 0, active = false;

    function frame() {
      let settled = true;
      chars.forEach((el, i) => {
        const c = cur[i], t = tgt[i];
        c.r += (t.r - c.r) * 0.18;
        c.w += (t.w - c.w) * 0.18;
        if (Math.abs(t.r - c.r) > 0.5 || Math.abs(t.w - c.w) > 0.5) settled = false;
        el.style.fontVariationSettings = `'ROND' ${c.r}, 'wght' ${c.w}`;
      });
      raf = settled && !active ? 0 : requestAnimationFrame(frame);
      if (!raf) chars.forEach((el) => (el.style.fontVariationSettings = ''));
    }
    function retarget(x: number | null) {
      const R = 90;
      chars.forEach((el, i) => {
        if (x === null) { tgt[i].r = 100; tgt[i].w = 700; return; }
        const b = el.getBoundingClientRect();
        const d = Math.abs(x - (b.left + b.width / 2));
        const k = Math.max(0, 1 - d / R);
        tgt[i].r = 100 - 100 * k;  // round → square as you approach
        tgt[i].w = 700 + 200 * k;  // and a touch heavier
      });
      if (!raf) raf = requestAnimationFrame(frame);
    }
    mdoto.addEventListener('mousemove', (e) => { active = true; retarget(e.clientX); });
    mdoto.addEventListener('mouseleave', () => { active = false; retarget(null); });
  }
</script>
