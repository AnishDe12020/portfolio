---
// Two renderings of the same section; the designer panel (bottom-left)
// switches between them via html[data-lab]. Content lives in src/data/content.ts.
import { lab } from '../data/content';
---
<section id="lab">
  <div class="label reveal">the lab</div>

  <div class="lab lab-listed reveal">
    <div class="rows">
      {lab.listed.map((p) => (
        <div class="row">
          <span class="name">{p.name}</span>
          <span class="desc">{p.desc}</span>
          <span class="meta">{p.meta}</span>
        </div>
      ))}
    </div>
    <p class="aside">{lab.aside}</p>
    <p class="aside root-note">{lab.rootNote}</p>
  </div>

  <div class="lab lab-redacted reveal">
    <div class="rows">
      {lab.redacted.map((p) => (
        <div class="row">
          <span class="name">{p.head}<span class="redact" style={`--n:${p.redact}`}></span>{p.tail}</span>
          <span class="desc">{p.desc}</span>
          <span class="meta">{p.meta}</span>
        </div>
      ))}
    </div>
    <p class="aside">{lab.redactedAside}</p>
  </div>
</section>

<style>
  .lab-redacted{ display:none; }
  html[data-lab="redacted"] .lab-listed{ display:none; }
  html[data-lab="redacted"] .lab-redacted{ display:block; }

  .redact{
    display:inline-block; vertical-align:baseline;
    height:.68em; width:calc(var(--n) * .58em);
    margin:0 .06em;
    background-image:radial-gradient(circle, var(--ink-dim) 32%, transparent 36%);
    background-size:.29em .29em; background-position:center;
  }
</style>
