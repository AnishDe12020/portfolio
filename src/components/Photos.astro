---
// Pulled from unsplash.com/@anishde — swap entries freely; any slot left
// beyond PHOTOS.length renders as a reserved dither tile.
const u = (id: string) => `https://images.unsplash.com/photo-${id}?w=600&q=75&fm=jpg&fit=crop`;
const PHOTOS: { src: string; alt: string; href?: string }[] = [
  {
    src: u('1769337950338-e9e7756f8e6e'),
    alt: 'aerial view of a city at night, streets glowing orange',
    href: 'https://unsplash.com/photos/aerial-view-of-a-city-at-night-with-glowing-lights-UU5Fz6iFYWg',
  },
  {
    src: u('1769339750380-10d847c26194'),
    alt: 'night skyline with a highway of light trails',
    href: 'https://unsplash.com/photos/0j7Dkm0giWs',
  },
  {
    src: u('1769339781920-f508ac260e64'),
    alt: 'top-down view of night roads winding under light ribbons',
    href: 'https://unsplash.com/photos/CNMZ5u0Oz-s',
  },
  {
    src: u('1769339279852-ef7ded088573'),
    alt: 'columns of glowing jellyfish tanks in a dark room',
    href: 'https://unsplash.com/photos/dMJGYVvmhrg',
  },
];
const SLOTS = 4;
---
<section>
  <div class="label reveal"><span class="n">(08)</span> through a lens</div>
  <div class="shots reveal">
    {Array.from({ length: SLOTS }).map((_, i) =>
      PHOTOS[i] ? (
        <a class="shot" href={PHOTOS[i].href ?? PHOTOS[i].src} target="_blank" rel="noopener">
          <img src={PHOTOS[i].src} alt={PHOTOS[i].alt} loading="lazy" />
        </a>
      ) : (
        <div class="shot empty" title="film pending"></div>
      )
    )}
  </div>
  <p class="aside">proof i occasionally go outside. more on <a href="https://unsplash.com/@anishde" target="_blank" rel="noopener">unsplash</a>.</p>
</section>

<style>
  .shots{ display:grid; grid-template-columns:repeat(4, 1fr); gap:10px; }
  @media (max-width:520px){ .shots{ grid-template-columns:repeat(2, 1fr); } }
  .shot{ aspect-ratio:1; display:block; border:1px solid var(--ink-faint); overflow:hidden; }
  .shot img{
    width:100%; height:100%; object-fit:cover; display:block;
    filter:grayscale(1) contrast(1.05); opacity:.8;
    transition:filter .3s ease, opacity .3s ease;
  }
  .shot:hover img{ filter:none; opacity:1; }
  .shot.empty{
    background-image:radial-gradient(circle, var(--ink-faint) 26%, transparent 30%);
    background-size:8px 8px; background-position:center;
    opacity:.55;
  }
</style>
