---
// Homepage strip: four curated night-city squares, breaking out of the text
// column. The full 40-photo set is at /photos; data in src/data/photos.ts.
import { photos, stripIds, unsplashSrc } from '../data/photos';
const strip = stripIds.map((id) => photos.find((p) => p.id === id)!).filter(Boolean);
---
<section id="photos">
  <div class="label reveal">through a lens</div>
  <div class="shots reveal">
    {strip.map((p) => (
      <a class="shot" href="/photos">
        <img src={unsplashSrc(p.id)} alt={p.desc} loading="lazy" />
      </a>
    ))}
  </div>
  <p class="aside">night cities, mostly. all 40 in <a href="/photos">/photos</a>.</p>
</section>

<style>
  /* the photos breach the text column — the one section that gets to be wide */
  .shots{
    display:grid; grid-template-columns:repeat(4, 1fr); gap:10px;
    width:min(848px, calc(100vw - 40px));
    margin-inline:calc((100% - min(848px, calc(100vw - 40px))) / 2);
  }
  @media (max-width:520px){ .shots{ grid-template-columns:repeat(2, 1fr); } }
  .shot{ aspect-ratio:1; display:block; border:1px solid var(--ink-faint); overflow:hidden; }
  .shot img{
    width:100%; height:100%; object-fit:cover; display:block;
    filter:grayscale(1) contrast(1.05); opacity:.8;
    transition:filter .3s ease, opacity .3s ease;
  }
  .shot:hover img{ filter:none; opacity:1; }
</style>
