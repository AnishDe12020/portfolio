---
// Hackathon wins as pixel trophies standing on a hairline shelf.
// rank 1 renders bright, rank 2 dimmer. Edit the list in src/data/content.ts.
import { trophies, shelfAside } from '../data/content';
---
<section id="shelf">
  <div class="label reveal">the shelf</div>
  <div class="shelf reveal">
    {trophies.map((w) => (
      <div class="trophy" title={w.meta}>
        <div class="perch"><canvas width="11" height="11" data-rank={w.rank}></canvas></div>
        <span class="tname">{w.name}</span>
        <span class="tmeta">{w.meta.split(' \u00b7 ').join('\u00a0\u00b7 ')}</span>
      </div>
    ))}
  </div>
  <p class="aside">{shelfAside}</p>
</section>

<style>
  /* zero column-gap so each row's perch borders fuse into one continuous shelf */
  .shelf{ display:grid; grid-template-columns:repeat(auto-fit, minmax(96px, 1fr)); gap:26px 0; }
  .trophy{ display:flex; flex-direction:column; align-items:center; text-align:center; }
  .perch{
    width:100%; display:flex; justify-content:center; align-items:flex-end;
    padding-bottom:1px; border-bottom:1px solid var(--ink-faint);
  }
  .trophy canvas{ width:55px; height:55px; image-rendering:pixelated; }
  .tname{ font-family:var(--mono); font-size:11px; letter-spacing:.1em; color:var(--ink); margin-top:12px; }
  .tmeta{ font-family:var(--mono); font-size:9px; letter-spacing:.02em; color:var(--ink-faint); line-height:1.4; text-wrap:balance; margin-top:5px; }
</style>

<script>
  const TROPHY = [
    '01111111110',
    '01111111110',
    '10111111101',
    '10111111101',
    '00111111100',
    '00011111000',
    '00001110000',
    '00000100000',
    '00001110000',
    '00111111100',
    '00111111100',
  ];
  // two close shades per rank — a hint of texture, not mud
  const PALETTES: Record<string, Record<string, string[]>> = {
    void:   { '1': ['#ece8e0', '#ded9cf'], '2': ['#8f8a80', '#817c72'] },
    ledger: { '1': ['#1c1811', '#2c261d'], '2': ['#6b6355', '#7a7264'] },
  };
  function paint() {
    const pal = PALETTES[document.documentElement.dataset.theme === 'ledger' ? 'ledger' : 'void'];
    for (const cv of document.querySelectorAll<HTMLCanvasElement>('.trophy canvas')) {
      const ctx = cv.getContext('2d')!;
      const shades = pal[cv.dataset.rank ?? '1'];
      ctx.clearRect(0, 0, 11, 11);
      for (let y = 0; y < 11; y++)
        for (let x = 0; x < 11; x++)
          if (TROPHY[y][x] === '1') {
            ctx.fillStyle = shades[Math.random() < 0.8 ? 0 : 1];
            ctx.fillRect(x, y, 1, 1);
          }
    }
  }
  paint();
  addEventListener('pf:designer', (e) => { if ((e as CustomEvent).detail?.key === 'theme') paint(); });
</script>
