<section class="specimen slide-specimen reveal" id="specimen">
  <div class="label" style="justify-content:center"><span class="n">(09)</span> specimen</div>
  <div class="specimen-readout specimen-readout-a" aria-hidden="true"><span>GEN / 009</span><b>bilateral<br/>void fauna</b></div>
  <button class="frame" id="spriteButton" type="button" aria-label="Generate a new pixel specimen">
    <canvas id="sprite" width="11" height="11" aria-hidden="true"></canvas>
  </button>
  <div class="specimen-readout specimen-readout-b" aria-hidden="true"><span>STATUS</span><b>alive-ish</b><small>click organism<br/>to mutate</small></div>
  <div class="cap" aria-live="polite">seed <b id="seed">0x0000</b> &nbsp;/&nbsp; activate to re-roll</div>
</section>

<style>
  .specimen{ margin-top:clamp(90px,15vh,150px); text-align:center; }
  .frame{
    display:inline-block; padding:18px; border:1px solid var(--ink-faint);
    color:inherit; background:none; cursor:pointer;
  }
  #sprite{ display:block; image-rendering:pixelated; width:176px; height:176px; }
  .cap{
    font-family:var(--mono); font-size:10px; letter-spacing:.18em; text-transform:uppercase;
    color:var(--ink-faint); margin-top:16px;
  }
  .cap b{ color:var(--ink-dim); font-weight:400; }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cv = document.getElementById('sprite') as HTMLCanvasElement;
  const button = document.getElementById('spriteButton') as HTMLButtonElement;
  const sx = cv.getContext('2d')!;
  const seedEl = document.getElementById('seed')!;
  const shades = ['#ece8e0', '#b8b3a8', '#6b675e'];
  let eyes: number[][] = [];

  function mb32(a: number) {
    return function () {
      a |= 0; a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function drawSprite(seed: number) {
    const r = mb32(seed), N = 11, mid = 5;
    sx.clearRect(0, 0, N, N);
    for (let y = 1; y < N; y++)
      for (let x = 1; x <= mid; x++) {
        if (r() < 0.52) {
          sx.fillStyle = shades[(r() * 3) | 0];
          sx.fillRect(x, y, 1, 1); sx.fillRect(N - 1 - x, y, 1, 1);
        }
      }
    const ey = 3 + ((r() * 3) | 0), ex = 2 + ((r() * 2) | 0);
    eyes = [[ex, ey], [N - 1 - ex, ey]];
    sx.fillStyle = '#ece8e0';
    eyes.forEach(([x, y]) => sx.fillRect(x, y, 1, 1));
    seedEl.textContent = '0x' + (seed >>> 0).toString(16).padStart(4, '0').slice(0, 6);
  }

  let sp = 0;
  for (const c of 'anishde12020') sp = (Math.imul(sp, 131) + c.charCodeAt(0)) >>> 0;
  drawSprite(sp);

  /* it blinks. of course it blinks. */
  setInterval(() => {
    if (reduce || !eyes.length || Math.random() >= 0.5) return;
    sx.clearRect(eyes[0][0], eyes[0][1], 1, 1);
    sx.clearRect(eyes[1][0], eyes[1][1], 1, 1);
    setTimeout(() => {
      sx.fillStyle = '#ece8e0';
      eyes.forEach(([x, y]) => sx.fillRect(x, y, 1, 1));
    }, 130);
  }, 3800);

  function reroll() {
    let n = 7;
    const iv = setInterval(() => {
      drawSprite((Math.random() * 0xffffffff) >>> 0);
      if (--n <= 0) { clearInterval(iv); drawSprite((Math.random() * 0xffffffff) >>> 0); }
    }, 30);
  }
  button.addEventListener('click', reroll);
  addEventListener('pf:konami', reroll);
  addEventListener('pf:reroll', reroll);
</script>
