---
// <Callout type="note|tip|warn" title="optional"> — asides for mdx posts
const { type = 'note', title } = Astro.props;
---
<aside class={`callout c-${type}`}>
  <span class="chead">[!{title ?? type}]</span>
  <div class="cbody"><slot /></div>
</aside>

<style>
  .callout{
    margin:0 0 1.4em; padding:12px 16px 10px;
    border-left:2px solid var(--ink-dim);
    background:rgba(236,232,224,.03);
    border-radius:0 4px 4px 0;
  }
  .chead{
    display:block; margin-bottom:6px;
    font-family:var(--mono); font-size:11px; letter-spacing:.14em; text-transform:lowercase;
    color:var(--ink-dim);
  }
  .cbody{ font-size:.95rem; }
  .cbody :global(p:last-child){ margin-bottom:0; }

  .c-warn{ border-left-color:var(--live); }
  .c-warn .chead{ color:var(--live); }
  .c-tip{ border-left-color:#46b96e; }
  .c-tip .chead{ color:#46b96e; }
</style>
