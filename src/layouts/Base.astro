---
import '../styles/global.css';
import '../styles/hacker.css';
import '../styles/ledger.css';
const {
  title = 'Anish De',
  description = 'Co-founder at Beanstalk — making onchain investing as easy as ordering food. Solana, Rust, Bangalore.',
  image = '/og.png',
  type = 'website',
  published = null,
} = Astro.props;
const site = Astro.site ?? new URL('https://anishde.dev');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiHost = (import.meta.env.PUBLIC_UMAMI_HOST || 'https://umami.anishde.dev').replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#141210" />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@AnishDe12020" />
  <link rel="alternate" type="application/rss+xml" title="anish de — writing" href="/rss.xml" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {umamiWebsiteId && (
    <script is:inline defer src={`${umamiHost}/script.js`} data-website-id={umamiWebsiteId}></script>
  )}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Doto:ROND,wght@0..100,100..900&family=Fraunces:ital,opsz,wght@0,9..144,600..900;1,9..144,600..900&family=Spectral:ital,wght@0,300;0,400;1,300&family=Space+Mono:wght@400;700&display=swap"
    rel="stylesheet"
  />
  <script is:inline>
    // apply saved designer state before first paint
    try {
      var s = JSON.parse(localStorage.getItem('pf-designer') || '{}');
      var qp = new URLSearchParams(location.search);
      var d = document.documentElement.dataset;
      for (var k of ['name', 'body', 'density', 'lab', 'signal', 'grain', 'scan', 'theme', 'crt']) {
        var v = qp.get(k) || s[k];
        if (v) d[k] = v;
      }
      if (s.access) d.access = s.access;
    } catch (e) {}
    // hidden sections (designer checkboxes) — hide before paint, no flash
    try {
      var off = JSON.parse(localStorage.getItem('pf-sections') || '[]');
      if (Array.isArray(off) && off.length) {
        var st = document.createElement('style');
        st.id = 'pf-off-style';
        st.textContent = off.map(function (i) { return '#' + i; }).join(',') + '{display:none!important}';
        document.head.appendChild(st);
      }
    } catch (e) {}
    // sync the browser chrome with the active theme's void —
    // before paint, then on every theme/signal flip
    (function () {
      var meta = document.querySelector('meta[name="theme-color"]');
      function sync() {
        var d = document.documentElement.dataset;
        var c = '#141210';
        if (d.theme === 'hacker') c = d.signal === 'green' ? '#010401' : d.signal === 'amber' ? '#070500' : '#080302';
        else if (d.theme === 'ledger') c = '#f4efe4';
        meta.setAttribute('content', c);
      }
      sync();
      addEventListener('pf:theme', sync);
      addEventListener('pf:designer', function (e) {
        if (['theme', 'signal'].includes(e.detail && e.detail.key)) sync();
      });
    })();
  </script>
</head>
<body>
  <div class="grain" id="grain"></div>
  <div class="scan"></div>
  <div class="vignette"></div>
  <div class="wrap">
    <main>
      <slot />
    </main>
  </div>
  <slot name="fixed" />

  <script>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* scroll reveals */
    const els = [...document.querySelectorAll('.reveal')];
    if (reduce) {
      els.forEach((e) => e.classList.add('in'));
    } else {
      const io = new IntersectionObserver(
        (en) => en.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }),
        { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
      );
      els.forEach((e) => io.observe(e));
    }

    /* egg: tab-away title */
    const realTitle = document.title;
    document.addEventListener('visibilitychange', () => {
      document.title = document.hidden ? '◉ come back' : realTitle;
    });

    /* egg: konami — grain storm, the void acknowledges you */
    const seq = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
    let ki = 0;
    addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA') return;
      if (e.key === seq[ki]) {
        if (++ki === seq.length) {
          ki = 0;
          document.getElementById('grain')?.classList.add('storm');
          document.getElementById('voidline')?.classList.add('on');
          dispatchEvent(new CustomEvent('pf:konami'));
          setTimeout(() => document.getElementById('grain')?.classList.remove('storm'), 900);
        }
      } else ki = e.key === seq[0] ? 1 : 0;
    });

    /* egg: a note for the people who open the console */
    console.log(
      '%canish de %c• %cview-source friendly. konami works. the sprite rerolls. press d. type : if you vim.\n%chiring or building something weird? contact[at]anishde[dot]dev',
      'color:#e4ded2;font-weight:bold', 'color:#cd5f4a', 'color:#6b675e', 'color:#6b675e'
    );
  </script>
</body>
</html>
