---
import Base from '../layouts/Base.astro';
import Hacker from '../components/Hacker.astro';
---
<Base title="404 — Anish De" description="not a thing.">
  <div class="nf">
    <h1 class="sr">404</h1>
    <canvas id="nfc" width="17" height="7" aria-hidden="true"></canvas>
    <p class="nfline">this page is not a thing.</p>
    <p class="aside">:q takes you <a href="/">home</a>.</p>
  </div>
  <Hacker slot="fixed" />
</Base>

<style>
  .nf{ min-height:70vh; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px; text-align:center; }
  #nfc{ image-rendering:pixelated; width:238px; max-width:80%; }
  .nfline{ font-size:1.1rem; color:var(--ink-body); }
  .nf .aside{ margin-top:0; }
</style>

<script>
  import { GLYPHS } from '../lib/pixel';

  const cv = document.getElementById('nfc') as HTMLCanvasElement;
  const ctx = cv.getContext('2d')!;
  const shades = ['#e4ded2', '#e4ded2', '#b8b3a8', '#6b675e'];
  let cx = 0;
  for (const ch of '404') {
    const glyph = GLYPHS[ch];
    for (let y = 0; y < 7; y++)
      for (let x = 0; x < 5; x++)
        if (glyph[y][x] === '1') {
          ctx.fillStyle = shades[(Math.random() * shades.length) | 0];
          ctx.fillRect(cx + x, y, 1, 1);
        }
    cx += 6;
  }
</script>
