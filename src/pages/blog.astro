---
import Base from '../layouts/Base.astro';
import Hacker from '../components/Hacker.astro';
import Designer from '../components/Designer.astro';
import Terminal from '../components/Terminal.astro';
import Saver from '../components/Saver.astro';

import { getCollection } from 'astro:content';
import { fmtDate as fmt, readMinutes } from '../lib/blog';

// the real blog: markdown files in src/content/blog/, published on push
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.date - +a.data.date)
  .map((e) => ({
    title: e.data.title,
    brief: e.data.description,
    slug: e.id,
    date: e.data.date,
    minutes: readMinutes(e.body ?? ''),
  }));

---
<Base title="writing — Anish De" description="Crypto, web3, ai — written in markdown and published from the repo.">
  <header class="bhead">
    <a class="back" href="/">&larr; cd ~</a>
    <span class="bpath">~/writing</span>
  </header>

  <h1 class="label reveal">i write sometimes</h1>
  <p class="body reveal bintro">
    Crypto, web3, ai — occasionally all three in the same sentence.
    Written in markdown, published by <b>git push</b>. No CMS was harmed.
  </p>

  {posts.length > 0 ? (
    <div class="rows reveal">
      {posts.map((p) => (
        <a class="post" href={`/blog/${p.slug}`}>
          <span class="ptitle">{p.title}</span>
          <span class="pmeta">{fmt(p.date)} &middot; {p.minutes} min</span>
          <span class="pdesc">{p.brief}</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="aside reveal">nothing here yet. the pipes work, the words are coming.</p>
  )}

  <footer class="reveal">
    <span><a href="/">back to the void</a></span>
    <span>written from the repo</span>
  </footer>

  <Hacker slot="fixed" />
  <Designer slot="fixed" />
  <Terminal slot="fixed" />
  <Saver slot="fixed" />
</Base>

<style>
  .bhead{
    display:flex; justify-content:space-between; align-items:baseline; gap:16px;
    padding-top:clamp(48px, 9vh, 90px); margin-bottom:clamp(40px, 7vh, 64px);
    font-family:var(--mono); font-size:11px; letter-spacing:.2em; text-transform:lowercase;
    color:var(--ink-dim);
  }
  .back{ color:var(--ink-dim); text-decoration:none; border-bottom:1px solid var(--ink-faint); }
  .back:hover{ color:var(--ink-body); }
  .bpath{ color:var(--ink-faint); }

  .bintro{ margin-bottom:44px; }
  .bintro a{ color:var(--ink); text-decoration:none; border-bottom:1px solid var(--ink-faint); }

  .post{
    display:flex; flex-wrap:wrap; align-items:baseline; gap:4px 16px;
    padding:16px 4px; border-bottom:1px solid var(--ink-faint);
    color:inherit; text-decoration:none; transition:background .2s ease;
  }
  .post:hover{ background:rgba(236,232,224,.025); }
  .ptitle{ flex:1 1 auto; min-width:min(100%, 340px); font-size:1.05rem; color:var(--ink); line-height:1.4; }
  .pmeta{ font-family:var(--mono); font-size:11px; letter-spacing:.12em; color:var(--ink-faint); white-space:nowrap; margin-left:auto; }
  .pdesc{ flex-basis:100%; font-size:.92rem; color:var(--ink-dim); line-height:1.45; }

  footer{ font-size:11px; }
  footer a{ border-bottom:none; }
</style>
