---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Experiments from '../components/Experiments.astro';
import Photos from '../components/Photos.astro';
import Specimen from '../components/Specimen.astro';
import Designer from '../components/Designer.astro';
import Terminal from '../components/Terminal.astro';
import Hacker from '../components/Hacker.astro';
import Saver from '../components/Saver.astro';
import { lede, now, before, contact, footer } from '../data/content';
---
<Base>
  <div id="intro">
    <Hero />
    <p class="lede reveal" set:html={lede}></p>
  </div>

  <section id="now">
    <div class="label reveal">right now</div>
    {now.map((p) => <p class="body reveal" set:html={p}></p>)}
  </section>

  <section id="before">
    <div class="label reveal">before this</div>
    {before.map((p) => <p class="body reveal" set:html={p}></p>)}
  </section>

  <Experiments />

  <Photos />

  <section id="contact">
    <div class="label reveal">find me</div>
    <div class="rows reveal">
      {contact.map((c) => (
        <a class="row" href={c.url} target="_blank" rel="noopener">
          <span class="name">{c.name}</span><span class="desc">{c.desc}</span>
          <span class="meta">{c.meta} <span class="a">&#8599;</span></span>
        </a>
      ))}
      <a class="row" href="#" id="emailrow">
        <span class="name">email</span><span class="desc">the long form</span>
        <span class="meta"><span id="emailtext">contact[at]anishde[dot]dev</span> <span class="a" id="emailhint">·&nbsp;decode</span></span>
      </a>
    </div>
  </section>

  <Specimen />

  <footer class="reveal" id="fin">
    <span id="voidline">{footer.void}</span>
    <span>{footer.place}</span>
    <span>&copy; 2026 / <button id="ver" title="click">{footer.version}</button> / <a href="https://github.com/AnishDe12020" target="_blank" rel="noopener">source</a> / <a href="/setup">setup</a> / analytics offline</span>
  </footer>

  <Hacker slot="fixed" />
  <Designer slot="fixed" />
  <Terminal slot="fixed" />
  <Saver slot="fixed" />
</Base>

<script>
  /* email: never in the DOM until you ask for it */
  const row = document.getElementById('emailrow') as HTMLAnchorElement;
  const txt = document.getElementById('emailtext')!;
  const hint = document.getElementById('emailhint')!;
  const addr = ['contact', 'anishde', 'dev'].join(' ').replace(' ', '@').replace(' ', '.');
  let decoded = false;

  function decode() {
    if (decoded) return;
    decoded = true;
    const glyphs = '·:•◦abcdefghijklmnopqrstuvwxyz@.';
    let step = 0;
    const iv = setInterval(() => {
      step++;
      const done = Math.floor((step / 14) * addr.length);
      txt.textContent =
        addr.slice(0, done) +
        [...addr.slice(done)].map(() => glyphs[(Math.random() * glyphs.length) | 0]).join('');
      if (done >= addr.length) {
        clearInterval(iv);
        txt.textContent = addr;
        row.href = 'mailto:' + addr;
        hint.innerHTML = '&#8599;';
      }
    }, 40);
  }
  row.addEventListener('click', (e) => {
    if (decoded) return; // second click follows the mailto
    e.preventDefault();
    decode();
  });
  addEventListener('pf:email', () => {
    // travel first, decode once the row is actually on screen
    const r = row.getBoundingClientRect();
    if (Math.abs(r.top + r.height / 2 - innerHeight / 2) < 80) { decode(); return; }
    let done = false;
    const finish = () => { if (done) return; done = true; decode(); };
    addEventListener('scrollend', finish, { once: true, capture: true });
    setTimeout(finish, 1200);
    row.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  /* footer version — click for the site's past lives */
  const ver = document.getElementById('ver')!;
  const vers = ["v1 — a high schooler's html", 'v2 — next.js, 137 stars', "v4 — you're looking at it", 'v4.0.0'];
  let vi = -1;
  ver.addEventListener('click', () => { vi = (vi + 1) % vers.length; ver.textContent = vers[vi]; });
</script>
