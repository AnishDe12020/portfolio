---
import { byline, lede, work, projects, research, contact, footer } from '../data/content';
const description = 'trading infrastructure on solana. rust, typescript, some go. bengaluru.';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>anish de</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0b0a09" />
  <link rel="canonical" href="https://anishde.dev/" />
  <meta property="og:title" content="anish de" />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://anishde.dev/og.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@AnishDe12020" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <main>
    <h1>anish de</h1>
    <p class="dim" set:html={byline}></p>

    <p set:html={lede}></p>

    <h2>work</h2>
    <ul>
      {work.map((w) => (
        <li>
          {w.url ? <a href={w.url} target="_blank" rel="noopener">{w.name}</a> : <b>{w.name}</b>}
          <span class="dim"> — {w.desc} · {w.meta}</span>
          <p class="body">{w.body}</p>
        </li>
      ))}
    </ul>

    <h2>projects</h2>
    <ul>
      {projects.map((p) => (
        <li>
          {p.url ? <a href={p.url} target="_blank" rel="noopener">{p.name}</a> : <b>{p.name}</b>}
          {p.desc && <span class="dim"> — {p.desc}{p.meta && ` · ${p.meta}`}</span>}
        </li>
      ))}
    </ul>

    <h2>research</h2>
    <ul>
      {research.map((r) => (
        <li>
          {r.url ? <a href={r.url} target="_blank" rel="noopener">{r.name}</a> : <b>{r.name}</b>}
          <span class="dim"> — {r.desc} · {r.meta}</span>
        </li>
      ))}
    </ul>

    <h2>contact</h2>
    <ul>
      {contact.map((c) => (
        <li>
          {c.url ? <a href={c.url} target="_blank" rel="noopener">{c.name}</a> : <b>{c.name}</b>}
          {c.desc && <span class="dim"> — {c.desc}</span>}
        </li>
      ))}
    </ul>

    <p class="dim foot">{footer.place} · <a href="https://github.com/AnishDe12020/portfolio" target="_blank" rel="noopener">source</a></p>
  </main>

  <style is:global>
    * { box-sizing: border-box; margin: 0; }
    body {
      background: #0b0a09;
      color: #c7c1b5;
      font: 16px/1.65 system-ui, -apple-system, sans-serif;
      text-transform: lowercase;
      -webkit-font-smoothing: antialiased;
    }
    main { max-width: 600px; margin: 0 auto; padding: 64px 24px 80px; }
    h1 { color: #e4ded2; font-size: 1.6rem; font-weight: 700; }
    h2 { color: #e4ded2; font-size: 1rem; font-weight: 700; margin: 2.4em 0 .6em; }
    p { margin: .8em 0; }
    ul { list-style: none; padding: 0; }
    li { margin: .5em 0; }
    li .body { margin: .2em 0 1em; }
    b { font-weight: 600; color: #e4ded2; }
    a { color: #e4ded2; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: #55514a; }
    a:hover { color: #cd5f4a; text-decoration-color: #cd5f4a; }
    .dim { color: #9c968b; }
    .foot { margin-top: 3em; font-size: .85rem; }
    ::selection { background: #cd5f4a; color: #0b0a09; }
  </style>
</body>
</html>
