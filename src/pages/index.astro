---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Lab from '../components/Lab.astro';
import Shelf from '../components/Shelf.astro';
import Photos from '../components/Photos.astro';
import Specimen from '../components/Specimen.astro';
import Designer from '../components/Designer.astro';
import Terminal from '../components/Terminal.astro';
import Hacker from '../components/Hacker.astro';
import Saver from '../components/Saver.astro';
import Deck from '../components/Deck.astro';
---
<Base deck>
  <div class="opener">
    <Hero />

    <p class="lede reveal">
      I build financial plumbing on <b>Solana</b>. Co-founder
      at <a href="https://beanstalk.fi" target="_blank" rel="noopener">Beanstalk</a>, where owning
      stocks, gold, and treasuries onchain gets as easy as ordering food — for the people fintech
      quietly skips. Done from Bangalore, on questionable amounts of sleep.
    </p>
  </div>

  <section>
    <div class="label reveal"><span class="n">(01)</span> right now</div>
    <p class="body reveal">
      I run product, frontend, and growth at <b>Beanstalk</b>. Somehow also
      still finishing an engineering degree at PES University.
    </p>
  </section>

  <section>
    <div class="label reveal"><span class="n">(02)</span> before this</div>
    <p class="body reveal">
      Protocol engineer at <b>Spicenet</b>, mostly living inside the cross-chain relayer. Before
      that, a long run of Solana hackathons — the shelf below has the receipts. Started all of
      this in high school; nobody checked my age.
    </p>
  </section>

  <Shelf />

  <Lab />

  <section>
    <div class="label reveal"><span class="n">(05)</span> things that escaped</div>
    <div class="rows reveal">
      <a class="row" href="https://github.com/AnishDe12020/unsus" target="_blank" rel="noopener">
        <span class="name">unsus</span>
        <span class="desc">npm firewall — installs dependencies like they're guilty until proven boring</span>
        <span class="meta">ts <span class="a">&#8599;</span></span>
      </a>
      <a class="row" href="https://github.com/AnishDe12020/solsignal" target="_blank" rel="noopener">
        <span class="name">solsignal</span>
        <span class="desc">verifiable trading-signal protocol on solana, entered a hackathon as "batman"</span>
        <span class="meta">rust <span class="a">&#8599;</span></span>
      </a>
      <a class="row" href="https://github.com/AnishDe12020/murmur" target="_blank" rel="noopener">
        <span class="name">murmur</span>
        <span class="desc">local-first cli that psychoanalyzes x profiles so you don't have to</span>
        <span class="meta">ts <span class="a">&#8599;</span></span>
      </a>
      <a class="row" href="https://github.com/AnishDe12020/thermac" target="_blank" rel="noopener">
        <span class="name">thermac</span>
        <span class="desc">all 168 temperature sensors in your mac, from the terminal</span>
        <span class="meta">sh <span class="a">&#8599;</span></span>
      </a>
      <a class="row" href="https://github.com/AnishDe12020?tab=repositories" target="_blank" rel="noopener">
        <span class="name">the graveyard</span>
        <span class="desc">rayauth, sendo, secli — repos at rest</span>
        <span class="meta">more <span class="a">&#8599;</span></span>
      </a>
    </div>
  </section>

  <section>
    <div class="label reveal"><span class="n">(06)</span> i write sometimes</div>
    <p class="body reveal">
      Crypto, web3, ai — new posts land at <a href="/blog">/blog</a>, written in
      markdown and published straight from the repo.
    </p>
  </section>

  <section>
    <div class="label reveal"><span class="n">(07)</span> meanwhile</div>
    <div class="meanwhile reveal">
      <div class="mrow"><span class="mkey">watching</span><span class="mval">the f1 season, rooting for chaos</span></div>
      <div class="mrow"><span class="mkey">lifting</span><span class="mval">progressive overload</span></div>
      <div class="mrow"><span class="mkey">rabbit hole</span><span class="mval">agents that babysit other agents</span></div>
    </div>
  </section>

  <Photos />

  <Specimen />

  <section>
    <div class="label reveal"><span class="n">(10)</span> find me</div>
    <div class="rows reveal">
      <a class="row" href="https://twitter.com/AnishDe12020" target="_blank" rel="noopener">
        <span class="name">x / twitter</span><span class="desc">where i mostly live</span>
        <span class="meta">@AnishDe12020 <span class="a">&#8599;</span></span>
      </a>
      <a class="row" href="https://github.com/AnishDe12020" target="_blank" rel="noopener">
        <span class="name">github</span><span class="desc">code, mostly rust lately</span>
        <span class="meta">@AnishDe12020 <span class="a">&#8599;</span></span>
      </a>
      <a class="row" href="#" id="emailrow">
        <span class="name">email</span><span class="desc">for anything longer</span>
        <span class="meta"><span id="emailtext">contact[at]anishde[dot]dev</span> <span class="a" id="emailhint">·&nbsp;decode</span></span>
      </a>
    </div>
    <p class="aside reveal">got a weird idea that needs a co-conspirator? <a href="#" id="amalink">pitch it</a> — subject line's already filled in.</p>
  </section>

  <footer class="reveal">
    <span id="voidline">you found the void. it found you back.</span>
    <span>bengaluru, india</span>
    <span>&copy; 2026 / <button id="ver" title="click">v3.0.0</button> / <a href="https://github.com/AnishDe12020" target="_blank" rel="noopener">source</a> / analytics offline</span>
  </footer>

  <Hacker slot="fixed" />
  <Deck slot="fixed" />
  <Designer slot="fixed" />
  <Terminal slot="fixed" />
  <Saver slot="fixed" />
</Base>

<script>
  /* email: never in the DOM until you ask for it */
  const row = document.getElementById('emailrow') as HTMLAnchorElement;
  const txt = document.getElementById('emailtext')!;
  const hint = document.getElementById('emailhint')!;
  const addr = ['contact', 'anishde', 'dev'].join(' ').replace(' ', '@').replace(' ', '.');
  let decoded = false;

  function decode() {
    if (decoded) return;
    decoded = true;
    const glyphs = '·:•◦abcdefghijklmnopqrstuvwxyz@.';
    let step = 0;
    const iv = setInterval(() => {
      step++;
      const done = Math.floor((step / 14) * addr.length);
      txt.textContent =
        addr.slice(0, done) +
        [...addr.slice(done)].map(() => glyphs[(Math.random() * glyphs.length) | 0]).join('');
      if (done >= addr.length) {
        clearInterval(iv);
        txt.textContent = addr;
        row.href = 'mailto:' + addr;
        hint.innerHTML = '&#8599;';
      }
    }, 40);
  }
  row.addEventListener('click', (e) => {
    if (decoded) return; // second click follows the mailto
    e.preventDefault();
    decode();
  });
  addEventListener('pf:email', () => {
    // travel first, decode once the row is actually on screen
    const r = row.getBoundingClientRect();
    if (Math.abs(r.top + r.height / 2 - innerHeight / 2) < 80) { decode(); return; }
    let done = false;
    const finish = () => { if (done) return; done = true; decode(); };
    addEventListener('scrollend', finish, { once: true, capture: true });
    setTimeout(finish, 1200);
    row.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  /* ama — mailto assembled on click, same no-scrapers rule as the email row */
  document.getElementById('amalink')!.addEventListener('click', (e) => {
    e.preventDefault();
    location.href = 'mailto:' + addr + '?subject=' + encodeURIComponent('i have a weird idea');
  });

  /* footer version — click for the site's past lives */
  const ver = document.getElementById('ver')!;
  const vers = ["v1 — a high schooler's html", 'v2 — next.js, 137 stars', "v3 — you're looking at it", 'v3.0.0'];
  let vi = -1;
  ver.addEventListener('click', () => { vi = (vi + 1) % vers.length; ver.textContent = vers[vi]; });
</script>
