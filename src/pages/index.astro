---
import Base from '../layouts/Base.astro';
import { byline, lede, work, projects, research, contact, footer } from '../data/content';
const description = 'trading infrastructure on solana. rust, typescript, some go. bengaluru.';
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Anish De',
  url: 'https://anishde.dev',
  jobTitle: 'protocol engineer',
  description,
  address: { '@type': 'PostalAddress', addressLocality: 'Bengaluru', addressCountry: 'IN' },
  sameAs: contact.filter((c) => c.url?.startsWith('http')).map((c) => c.url),
};
---
<Base description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(person)}></script>
  </Fragment>
  <main>
    <h1>anish de</h1>
    <p class="dim" set:html={byline}></p>
    <p class="dim"><a href="/photos">photos</a></p>

    <p set:html={lede}></p>

    <h2>work</h2>
    <ul>
      {work.map((w) => (
        <li>
          {w.url ? <a href={w.url} target="_blank" rel="noopener">{w.name}</a> : <b>{w.name}</b>}
          <span class="dim"> — {w.desc} · {w.meta}</span>
          <p class="body">{w.body}</p>
        </li>
      ))}
    </ul>

    <h2>projects</h2>
    <ul>
      {projects.map((p) => (
        <li>
          {p.url ? <a href={p.url} target="_blank" rel="noopener">{p.name}</a> : <b>{p.name}</b>}
          {p.desc && <span class="dim"> — {p.desc}{p.meta && ` · ${p.meta}`}</span>}
        </li>
      ))}
    </ul>

    <h2>research</h2>
    <ul>
      {research.map((r) => (
        <li>
          {r.url ? <a href={r.url} target="_blank" rel="noopener">{r.name}</a> : <b>{r.name}</b>}
          <span class="dim"> — {r.desc} · {r.meta}</span>
        </li>
      ))}
    </ul>

    <h2>contact</h2>
    <ul>
      {contact.map((c) => (
        <li>
          {c.url ? <a href={c.url} target={c.url.startsWith('/') ? undefined : '_blank'} rel={c.url.startsWith('/') ? undefined : 'noopener'}>{c.name}</a> : <b>{c.name}</b>}
          {c.desc && <span class="dim"> — {c.desc}</span>}
        </li>
      ))}
    </ul>

    <p class="dim foot">{footer.place} · <a href="https://github.com/AnishDe12020/portfolio" target="_blank" rel="noopener">source</a></p>
  </main>
</Base>
