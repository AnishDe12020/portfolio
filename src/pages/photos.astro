---
import Base from '../layouts/Base.astro';
import Hacker from '../components/Hacker.astro';
import Terminal from '../components/Terminal.astro';
import { photos, photoHref, unsplashSrc } from '../data/photos';
---
<Base title="photos — Anish De" description="Night cities, monuments, and whatever else held still. Photos by Anish De.">
  <div class="ph">
    <div class="label">through a lens</div>
    <p class="lede">Night cities, monuments, and whatever else held still long enough.</p>

    <div class="masonry">
      {photos.map((p) => (
        <a class="card shot" href={photoHref(p.slug)} target="_blank" rel="noopener">
          <img
            src={unsplashSrc(p.id, 800)}
            alt={p.desc}
            loading="lazy"
            style={`aspect-ratio:${p.w}/${p.h}`}
          />
          {p.exif && <span class="exif">{p.exif}</span>}
        </a>
      ))}
    </div>

    <p class="aside"><a href="/">home</a> · everything above lives on <a href="https://unsplash.com/@anishde" target="_blank" rel="noopener">unsplash</a>, free to take.</p>
  </div>
  <Hacker slot="fixed" />
  <Terminal slot="fixed" />
</Base>

<style>
  .ph{ padding-top:clamp(56px,10vh,96px); }
  .ph .lede{ margin-top:18px; }
  /* masonry: natural aspect ratios, no crops. wider than the text column. */
  .masonry{
    columns:2; column-gap:14px;
    margin-top:clamp(36px,5vh,52px);
    width:min(848px, calc(100vw - 40px));
    margin-inline:calc((100% - min(848px, calc(100vw - 40px))) / 2);
  }
  @media (max-width:520px){ .masonry{ columns:1; } }
  .card{ break-inside:avoid; margin:0 0 14px; }
  .shot{ display:block; border:1px solid var(--ink-faint); overflow:hidden; position:relative; }
  .shot img{
    width:100%; display:block;
    filter:grayscale(1) contrast(1.05); opacity:.85;
    transition:filter .3s ease, opacity .3s ease;
  }
  .shot:hover img{ filter:none; opacity:1; }
  /* camera line: tiny, bottom-left, only when you look closely */
  .exif{
    position:absolute; left:0; right:0; bottom:0; padding:16px 10px 7px;
    font-family:var(--mono); font-size:9px; letter-spacing:.1em; text-transform:lowercase;
    color:#cfc9bd; background:linear-gradient(transparent, rgba(6,6,6,.75));
    opacity:0; transition:opacity .3s ease;
  }
  .shot:hover .exif{ opacity:1; }
  .ph .aside{ margin-top:clamp(36px,5vh,52px); padding-bottom:8vh; }
  .ph .aside a{ color:var(--ink-dim); }
</style>
