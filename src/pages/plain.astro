---
// The simple version, plus exactly two signatures: the red-tick mono labels
// and the specimen pet. Everything else is words.
import { hero, lede, now, before, experiments, experimentsAside, contact, footer } from '../data/content';
import { photos, stripIds, unsplashSrc } from '../data/photos';
const strip = stripIds.map((id) => photos.find((p) => p.id === id)!).filter(Boolean);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>anish de</title>
  <meta name="description" content="co-founder at beanstalk. rust on solana, from bangalore." />
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#0b0a09" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>
  <main>
    <h1>anish de</h1>
    <p class="dim byline" set:html={hero.byline}></p>
    <nav><a href="/photos">/photos</a> <a href="https://x.com/AnishDe12020">x</a> <a href="https://github.com/AnishDe12020">github</a></nav>

    <p set:html={lede}></p>

    <h2>right now</h2>
    {now.map((p) => <p set:html={p}></p>)}

    <h2>before this</h2>
    {before.map((p) => <p set:html={p}></p>)}

    <h2>experiments</h2>
    <ul>
      {experiments.map((p) => (
        <li>
          {p.url ? <a href={p.url}>{p.name}</a> : <span class="name">{p.name}</span>}
          <span class="dim"> — {p.desc}</span>
        </li>
      ))}
    </ul>
    <p class="dim small">{experimentsAside}</p>

    <h2>photos</h2>
    <div class="strip">
      {strip.map((p) => (
        <a href="/photos"><img src={unsplashSrc(p.id, 400)} alt={p.desc} loading="lazy" /></a>
      ))}
    </div>

    <h2>find me</h2>
    <ul>
      {contact.map((c) => (
        <li><a href={c.url}>{c.name}</a><span class="dim"> — {c.desc}</span></li>
      ))}
      <li><span class="name">email</span><span class="dim"> — contact [at] anishde [dot] dev</span></li>
    </ul>

    <div class="pet">
      <button id="spriteButton" type="button" aria-label="generate a new pixel specimen">
        <canvas id="sprite" width="11" height="11" aria-hidden="true"></canvas>
      </button>
      <p class="dim small"><span id="seed">0x0000</span> · poke it</p>
    </div>

    <p class="dim small foot">{footer.place} · <a href="https://github.com/AnishDe12020">source</a></p>
  </main>

  <style>
    * { box-sizing: border-box; margin: 0; }
    body {
      background: #0b0a09; color: #c7c1b5;
      font: 16px/1.65 system-ui, -apple-system, sans-serif;
      text-transform: lowercase;
    }
    main { max-width: 600px; margin: 0 auto; padding: 64px 24px 80px; }
    h1 { color: #e4ded2; font-size: 1.6rem; font-weight: 650; }
    .byline { font-family: 'Space Mono', monospace; font-size: 11px; letter-spacing: .14em; }
    h2 {
      display: flex; align-items: center; gap: 10px;
      font-family: 'Space Mono', monospace; font-size: 11px; font-weight: 400;
      letter-spacing: .22em; color: #9c968b; margin: 2.6em 0 .7em;
    }
    h2::before { content: ""; width: 22px; height: 2px; background: #cd5f4a; }
    p { margin: .8em 0; }
    nav { margin: .5em 0 2em; font-family: 'Space Mono', monospace; font-size: 12px; }
    nav a { margin-right: 14px; text-decoration: none; color: #9c968b; }
    nav a:hover { color: #cd5f4a; }
    a { color: #e4ded2; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: #55514a; }
    a:hover { text-decoration-color: #cd5f4a; }
    ul { list-style: none; padding: 0; }
    li { margin: .45em 0; }
    .name { color: #e4ded2; }
    .dim { color: #9c968b; }
    .small { font-size: .85rem; }
    b { font-weight: 500; color: #e4ded2; }
    .strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .strip img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
    @media (max-width: 480px) { .strip { grid-template-columns: repeat(2, 1fr); } }
    .pet { text-align: center; margin: 56px 0 0; }
    .pet button { background: none; border: 1px solid #3a362f; padding: 9px; cursor: pointer; }
    .pet canvas { display: block; width: 55px; height: 55px; image-rendering: pixelated; }
    .pet p { margin-top: 8px; font-family: 'Space Mono', monospace; font-size: 10px; letter-spacing: .16em; }
    .foot { margin-top: 40px; text-align: center; font-family: 'Space Mono', monospace; font-size: 10px; letter-spacing: .14em; }
  </style>

  <script>
    // the pet: deterministic sprite, blinks, rerolls on poke
    const cv = document.getElementById('sprite') as HTMLCanvasElement;
    const g = cv.getContext('2d')!;
    const seedEl = document.getElementById('seed')!;
    let eyes: number[][] = [];
    function mb32(a: number) {
      return function () {
        a |= 0; a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    function draw(seed: number) {
      const r = mb32(seed), N = 11, mid = 5;
      g.clearRect(0, 0, N, N);
      const body = ['#e4ded2', '#b8b3a8', '#6b675e'];
      for (let y = 1; y < N; y++)
        for (let x = 1; x <= mid; x++)
          if (r() < 0.52) {
            g.fillStyle = body[(r() * 3) | 0];
            g.fillRect(x, y, 1, 1); g.fillRect(N - 1 - x, y, 1, 1);
          }
      const ey = 3 + ((r() * 3) | 0), ex = 2 + ((r() * 2) | 0);
      eyes = [[ex, ey], [N - 1 - ex, ey]];
      g.fillStyle = '#e4ded2';
      eyes.forEach(([x, y]) => g.fillRect(x, y, 1, 1));
      seedEl.textContent = '0x' + (seed >>> 0).toString(16).padStart(4, '0').slice(0, 6);
    }
    let sp = 0;
    for (const c of 'anishde12020') sp = (Math.imul(sp, 131) + c.charCodeAt(0)) >>> 0;
    draw(sp);
    setInterval(() => {
      if (!eyes.length || Math.random() >= 0.5) return;
      eyes.forEach(([x, y]) => g.clearRect(x, y, 1, 1));
      setTimeout(() => { g.fillStyle = '#e4ded2'; eyes.forEach(([x, y]) => g.fillRect(x, y, 1, 1)); }, 130);
    }, 3800);
    document.getElementById('spriteButton')!.addEventListener('click', () => {
      let n = 7;
      const iv = setInterval(() => {
        draw((Math.random() * 0xffffffff) >>> 0);
        if (--n <= 0) clearInterval(iv);
      }, 30);
    });
  </script>
</body>
</html>
