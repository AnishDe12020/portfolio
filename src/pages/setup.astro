---
import Base from '../layouts/Base.astro';
import Hacker from '../components/Hacker.astro';
import Terminal from '../components/Terminal.astro';
import { setup, setupAside } from '../data/content';
---
<Base title="setup — Anish De" description="The machines, drawn one pixel at a time.">
  <div class="su">
    <div class="label">the setup</div>
    <p class="lede">The machines, drawn one pixel at a time.</p>

    <div class="cabinet">
      {setup.map((s) => (
        <div class="gear">
          <div class="perch"><canvas class="device" data-sprite={s.sprite} aria-hidden="true"></canvas></div>
          <span class="gname">{s.name}</span>
          <span class="gdesc">{s.desc}</span>
          <span class="gmeta">{s.meta}</span>
        </div>
      ))}
    </div>

    <p class="aside">{setupAside} <a href="/">home</a>.</p>
  </div>
  <Hacker slot="fixed" />
  <Terminal slot="fixed" />
</Base>

<style>
  .su{ padding-top:clamp(56px,10vh,96px); }
  .su .lede{ margin-top:18px; }
  /* zero column-gap so perch borders fuse into continuous shelves per row */
  .cabinet{
    display:grid; grid-template-columns:repeat(3, 1fr); gap:44px 0;
    margin-top:clamp(40px,6vh,60px);
  }
  @media (max-width:520px){ .cabinet{ grid-template-columns:repeat(2, 1fr); } }
  .gear{ display:flex; flex-direction:column; align-items:center; text-align:center; padding:0 8px; }
  .perch{
    width:100%; display:flex; justify-content:center; align-items:flex-end;
    height:96px; padding-bottom:1px; border-bottom:1px solid var(--ink-faint);
  }
  .device{ image-rendering:pixelated; }
  .gname{ font-family:var(--mono); font-size:11px; letter-spacing:.1em; color:var(--ink); margin-top:12px; }
  .gdesc{ font-size:.9rem; color:var(--ink-dim); line-height:1.4; margin-top:6px; max-width:180px; }
  .gmeta{ font-family:var(--mono); font-size:9px; letter-spacing:.14em; color:var(--ink-faint); margin-top:7px; text-transform:lowercase; }
  .su .aside{ margin-top:clamp(44px,7vh,64px); padding-bottom:8vh; }
  .su .aside a{ color:var(--ink-dim); }
</style>

<script>
  // Pixel devices. Legend: 1 body (dithered pair), 2 recessed/screen, 3 live accent.
  const MAPS: Record<string, string[]> = {
    mbp: [
      '..111111111111111111..',
      '..122222222222222221..',
      '..122222222222222221..',
      '..123222222222222221..',
      '..122222222222222221..',
      '..122222222222222221..',
      '..122222222222222221..',
      '..111111111111111111..',
      '1111111111111111111111',
      '1111111112222111111111',
      '.11111111111111111111.',
    ],
    mba: [
      '..111111111111111111..',
      '..122222222222222221..',
      '..122222222222222221..',
      '..122222232222222221..',
      '..122222222222222221..',
      '..111111111111111111..',
      '1111111111111111111111',
      '.11111111111111111111.',
    ],
    iphone: [
      '.11111111.',
      '1111111111',
      '1211111121',
      '1222222221',
      '1222222221',
      '1222222221',
      '1222222221',
      '1222222221',
      '1222232221',
      '1222222221',
      '1222222221',
      '1222222221',
      '1222222221',
      '1111111111',
      '.11111111.',
    ],
    keyboard: [
      '......................',
      '1111111111111111111111',
      '1211211211211211211211',
      '1111111111111111111111',
      '1211211211211211211211',
      '1111111111111111111111',
      '1122222222222222222211',
      '1111111111111111111111',
    ],
    headphones: [
      '.....111111.....',
      '...1111111111...',
      '..111......111..',
      '..11........11..',
      '.111........111.',
      '.111........111.',
      '1221........1221',
      '1221........1221',
      '1221........1221',
      '.11..........11.',
    ],
    terminal: [
      '111111111111111111',
      '131111111111111111',
      '111111111111111111',
      '122222222222222221',
      '123122222222222221',
      '122222222222222221',
      '122332222222222221',
      '122222222222222221',
      '122222222222222221',
      '111111111111111111',
    ],
  };
  const SCALE = 5;
  function palette() {
    const ledger = document.documentElement.dataset.theme === 'ledger';
    const live = getComputedStyle(document.documentElement).getPropertyValue('--live').trim() || '#e0442e';
    return ledger
      ? { body: ['#1c1811', '#2c261d'], rec: '#8a8073', live }
      : { body: ['#ece8e0', '#ded9cf'], rec: '#55514a', live };
  }
  function paint() {
    const P = palette();
    for (const cv of document.querySelectorAll<HTMLCanvasElement>('.device')) {
      const map = MAPS[cv.dataset.sprite ?? ''];
      if (!map) continue;
      const w = map[0].length, h = map.length;
      cv.width = w; cv.height = h;
      cv.style.width = `${w * SCALE}px`; cv.style.height = `${h * SCALE}px`;
      const g = cv.getContext('2d')!;
      g.clearRect(0, 0, w, h);
      for (let y = 0; y < h; y++)
        for (let x = 0; x < w; x++) {
          const c = map[y][x];
          if (c === '.') continue;
          g.fillStyle = c === '3' ? P.live : c === '2' ? P.rec : P.body[Math.random() < 0.82 ? 0 : 1];
          g.fillRect(x, y, 1, 1);
        }
    }
  }
  paint();
  addEventListener('pf:designer', (e) => { if ((e as CustomEvent).detail?.key === 'theme') paint(); });
</script>
